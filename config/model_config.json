    "relationshipTypes": [
      "FUNDS",
      "MANAGES",
      "IMPLEMENTS",
      "BENEFITS",
      "DEPENDS_ON",
      "LOCATED_IN",
      "MEASURES",
      "ALLOCATES_TO",
      "OTHER"
    ]
  },
  "preprocessing": {
    "maxChunkLength": 3000,
    "tabularDetectionThreshold": 0.3,
    "skipThreshold": 0.7,
    "normalizeNonAscii": true,
    "collapseWhitespace": true
  },
  "alternativeModels": {
