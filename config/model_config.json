    "parameters": "4B (effective via selective activation)",
    "quantization": "INT4",
    "source": "https://huggingface.co/google/gemma-3n-E4B-it-litert-lm",
    "license": "Gemma Terms of Use",
    "phonePath": "/data/local/tmp/gemma-3n-E4B-it-int4.litertlm"
  },
  "library": {
    "name": "LiteRT LM",
    "package": "com.google.ai.edge.litertlm:litertlm",
    "version": "0.0.0-alpha05",
    "repository": "https://maven.google.com",
    "notes": "Pin to alpha05 - alpha06+ changes NPU APIs"
  },
  "mediapipe": {
    "package": "com.google.mediapipe:tasks-genai",
    "version": "0.10.27",
    "backend": "GPU"
  },
  "inference": {
    "backend": "GPU",
    "maxTokens": 4096,
    "contextLength": 1024,
    "temperature": 0.5,
    "topK": 40,
    "topP": 0.95
  },
  "entityExtraction": {
    "entityTypes": [
      "ORGANIZATION",
      "PROGRAM",
      "PROJECT",
      "PERSON",
      "LOCATION",
      "BUDGET_ITEM",
      "METRIC",
      "OTHER"
